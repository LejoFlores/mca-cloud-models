# Apptainer image built from the local Docker image schnaps:1.1.1-gpu-cuda12.4 (build that first; see containers/README.md).
#   apptainer build schnaps-1.1.1-gpu-cuda12.4.sif containers/schnaps/schnaps-gpu.def
# Equivalent without this file:  apptainer build schnaps-1.1.1-gpu-cuda12.4.sif docker-daemon://schnaps:1.1.1-gpu-cuda12.4
# The Docker ENV (PATH, LD_LIBRARY_PATH, OMPI_*, ...) carries over. GPU images need --nv at run time.
Bootstrap: docker-daemon
From: schnaps:1.1.1-gpu-cuda12.4

%labels
    org.opencontainers.image.source https://github.com/LejoFlores/mca-cloud-models
    org.opencontainers.image.title schnaps-1.1.1-gpu-cuda12.4

%help
    Versions are in /opt/manifest.txt:  apptainer exec schnaps-1.1.1-gpu-cuda12.4.sif cat /opt/manifest.txt
    Run:  apptainer exec --nv schnaps-1.1.1-gpu-cuda12.4.sif mpirun -np 2 SCHNAPS_gpu case.nml

%runscript
    exec "$@"

%test
    cat /opt/manifest.txt
    command -v SCHNAPS_gpu
